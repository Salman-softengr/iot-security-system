# --- HYBRID CLOUD CONFIGURATION ---
# Use these when moving away from Docker Compose to managed services

# 1. Upstash Kafka (Serverless)
# Get these from console.upstash.com
KAFKA_BOOTSTRAP_SERVERS=your-endpoint.upstash.io:9092
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_USER=your-upstash-user
KAFKA_PASS=your-upstash-pass
KAFKA_TOPIC=network-telemetry

# 2. Neon.tech Postgres (Serverless)
# Get from neon.tech
DATABASE_URL=postgresql://user:pass@ep-cool-name.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Upstash Redis (Serverless)
# Get from console.upstash.com
REDIS_URL=rediss://default:your-pass@your-endpoint.upstash.io:6379

# 4. Security
JWT_SECRET=generate-a-long-random-string
JWT_ALGORITHM=HS256

# 5. ML Config
ANOMALY_THRESHOLD=0.70

# 6. API URL (For Dashboard)
# The URL where your Orchestrator is hosted (e.g. on Koyeb)
VITE_API_URL=https://your-orchestrator-app.koyeb.app
