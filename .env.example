# IoT Security System Configuration

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=network-telemetry

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iot_security
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# ML Config
ANOMALY_THRESHOLD=0.70
LOG_LEVEL=INFO

# Security
JWT_SECRET=change_me_to_a_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Edge Collector
MONITOR_INTERFACE=eth0
SIMULATION_MODE=true

# Ansible (Simulation)
ANSIBLE_SIMULATION=true
SWITCH_STATE_FILE=/tmp/switch_state.json
